# Intelli-Credit Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API (required for text extraction, OCR cleanup, sector classification)
GROQ_API_KEY=your_groq_api_key_here

# Serper API (primary news search)
SERPER_API_KEY=your_serper_api_key_here

# NewsAPI (tertiary fallback for news search)
NEWSAPI_KEY=your_newsapi_key_here

# Optional: Set to "demo" to skip API calls during development
# MODE=demo
